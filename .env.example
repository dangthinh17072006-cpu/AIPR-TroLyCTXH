# Mặc định chạy local (không cần API, không cần key). API mode KHÔNG tự chuyển về local.
AIPR_MODE=local
# Điền key CỦA BẠN vào file .env (đã nằm trong .gitignore). KHÔNG điền key thật vào file này.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Tùy chọn: thư mục Week_4 của lớp chứa Vector_Store.py (embedding thật cho dense/hybrid).
# W4_PATH=../Week_4
